{
    // 本文件主要定义了通用 UI 的行为和显示内容
    // 可参考文档和示例添加更多您需要的功能
    // 文档：https://maafw.xyz/docs/3.3-ProjectInterfaceV2
    // 示例：https://github.com/MaaXYZ/MaaFramework/blob/main/sample/interface.json
    "interface_version": 2,
    "name": "MaaOH",
    "label": "MaaOH",
    "title": "百分之一小助手",
    "description": "百分之一一键日常",
    "contact": "QQ群: 123456789",
    "license": "MIT",
    "welcome": "首次使用！欢迎使用 MaaOH!",
    // 填写项目地址和版本号可实现自动更新功能
    "github": "https://github.com/FelixTaXk/MaaOH",
    "version": "v0.0.4",
    "icon": "resource/logo.ico",
    // Mirror酱为第三方分发服务，新项目默认关闭
    // 若有需要请联系 Mirror酱 开通，直接自3行开启是无法使用的
    // "mirrorchyan_rid": "MaaXXX",
    // "mirrorchyan_multiplatform": true,
    "controller": [
        {
            "name": "安卓端",
            "type": "Adb",
            "display_short_side": 720 // 默认缩放分辨率的短边长度
        }
    ],
    "resource": [
        {
            "name": "官服",
            "path": [
                "./resource"
            ]
        }
    ],
    // 可选的 agent 示例
    // "agent": {
    //     "child_exec": "python",
    //     "child_args": [
    //         "./agent/main.py"
    //     ]
    // },
    "task": [
        {
            "name": "启动游戏",
            "entry": "gameLogin"
        },
        {
            "name": "签到",
            "entry": "startCheckInTask"
        },
        {
            "name": "收取电量",
            "entry": "startBatteryTask"
        },
        {
            "name": "好友收赠",
            "entry": "startFriendTask",
            "description": "收取好友电量"
        },
        {
            "name": "每日抽卡",
            "entry": "startGachaTask",
            "description": "每日一次免费抽卡"
        },
        {
            "name": "决斗王抽卡",
            "entry": "startDuelTask",
            "description": "每日一次免费抽卡"
        },
        {
            "name": "基站收取",
            "entry": "startBaseTask",
            "description": "一键领取材料"
        },
        {
            "name": "临界次元兑换",
            "entry": "startDimensionTask",
            "description": "2000金币兑换"
        },
        {
            "name": "自动冒险",
            "entry": "startAdventureTask",
            "description": "默认最高关卡挑战模式N03（关卡选择请等待后续更新）"
        },
        {
            "name": "积分赛",
            "entry": "startPointRaceTask",
            "description": "默认最高",
            "option": [
                "对手等级"
            ]
        },
        {
            "name": "每日委托",
            "entry": "startDailyCommissionTask",
            "description": "一键扫荡每日委托"
        },
        {
            "name": "限时活动",
            "entry": "startLimitedTimeEventTask",
            "description": "领取免费票券，默认打最后一关，需要提前编好队伍",
            "option": [
                "活动等级"
            ]
        },
        {
            "name": "分解卡牌",
            "entry": "startBreakDownCardTask",
            "description": "分解一次卡牌"
        },
        {
            "name": "领取奖励",
            "entry": "startClaimRewardTask",
            "description": "领取日常周常任务（最后一个执行）"
        }
    ],
    "option": {
        "对手等级": {
            "type": "select",
            "label": "对手等级",
            "description": "选择需要对战的对手等级",
            "default_case": "高级",
            "cases": [
                {
                    "name": "初级",
                    "pipeline_override": {
                        "enterLevel1": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "中级",
                    "pipeline_override": {
                        "enterLevel2": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "高级",
                    "pipeline_override": {
                        "enterLevel3": {
                            "enabled": true
                        }
                    }
                },
            ]
        },
        "活动等级": {
            "type": "select",
            "label": "活动等级",
            "description": "选择需要对战的活动等级",
            "default_case": "lv45",
            "cases": [
                {
                    "name": "lv5",
                    "pipeline_override": {
                        "checkLevel5": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "lv15",
                    "pipeline_override": {
                        "checkLevel15": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "lv30",
                    "pipeline_override": {
                        "checkLevel30": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "lv45",
                    "pipeline_override": {
                        "checkLevel45": {
                            "enabled": true
                        }
                    }
                }
            ]
        }
    }
}